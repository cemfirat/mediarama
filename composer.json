{
  "name": "cemfirat/mediarama",
  "description": "Modern photo and video gallery platform inspired by Coppermine.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "doctrine/doctrine-bundle": "^3.1",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.5",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-pdo_pgsql": "*",
    "league/flysystem": "^3.30",
    "league/flysystem-aws-s3-v3": "^3.30",
    "php": "^8.5",
    "symfony/asset": "^8.1",
    "symfony/console": "^8.1",
    "symfony/doctrine-messenger": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/flex": "^2.8",
    "symfony/framework-bundle": "^8.1",
    "symfony/messenger": "^8.1",
    "symfony/process": "^8.1",
    "symfony/rate-limiter": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/phpunit-bridge": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Mediarama\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mediarama\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "require": "8.1.*"
    }
  }
}
