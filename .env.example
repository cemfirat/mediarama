APP_ENV=dev
APP_SECRET=replace-with-a-local-secret

# Browser first-run setup is disabled unless this secret contains at least 32
# characters. Generate a high-entropy value on the server; never commit a real token.
MEDIARAMA_SETUP_TOKEN=""

# Canonical public origin used for sitemaps and future canonical/social URLs.
# Use the externally reachable scheme + host (and port when non-standard), with no path.
PUBLIC_BASE_URL="https://gallery.example.com"
DATABASE_URL="postgresql://mediarama:mediarama@127.0.0.1:5432/mediarama"
MESSENGER_TRANSPORT_DSN="doctrine://default?queue_name=async&auto_setup=false"

MEDIA_STORAGE_PATH="/var/lib/mediarama/media"
EXIFTOOL_BINARY="exiftool"
FFPROBE_BINARY="ffprobe"
FFPROBE_PROCESS_TIMEOUT_SECONDS=30
FFPROBE_PROBE_SIZE_BYTES=33554432
FFPROBE_ANALYZE_DURATION_US=5000000

# Video presentation derivatives are generated server-side. These settings are
# deployment policy, never request parameters.
FFMPEG_BINARY="ffmpeg"
FFMPEG_PROCESS_TIMEOUT_SECONDS=900
VIDEO_POSTER_MAX_WIDTH=1280
VIDEO_POSTER_MAX_HEIGHT=1280
VIDEO_PLAYBACK_MAX_WIDTH=1920
VIDEO_PLAYBACK_MAX_HEIGHT=1080
VIDEO_PLAYBACK_VIDEO_CODEC="libx264"
VIDEO_PLAYBACK_CRF=23
VIDEO_PLAYBACK_PRESET="medium"
VIDEO_PLAYBACK_AUDIO_CODEC="aac"
VIDEO_PLAYBACK_AUDIO_BITRATE="128k"
UPLOAD_MAX_ASSET_BYTES=2147483648
UPLOAD_MAX_CHUNK_BYTES=16777216
IMAGEMAGICK_BINARY="magick"
IMAGEMAGICK_IDENTIFY_BINARY="identify"
IMAGEMAGICK_LIMIT_MEMORY="256MiB"
IMAGEMAGICK_LIMIT_MAP="512MiB"
IMAGEMAGICK_LIMIT_DISK="2GiB"
IMAGEMAGICK_LIMIT_AREA="512MiB"
IMAGEMAGICK_LIMIT_WIDTH=32768
IMAGEMAGICK_LIMIT_HEIGHT=32768
IMAGEMAGICK_LIMIT_FILES=128
IMAGEMAGICK_LIMIT_THREADS=2
IMAGEMAGICK_LIMIT_TIME_SECONDS=45
IMAGEMAGICK_LIMIT_LIST_LENGTH=32
IMAGEMAGICK_PROCESS_TIMEOUT_SECONDS=60
CWEBP_BINARY="cwebp"
CWEBP_PROCESS_TIMEOUT_SECONDS=60

# Optional derivative watermark. Keep the asset path empty unless a derivative
# profile is explicitly configured with watermark=true. The asset must be a
# readable PNG; the path is deployment configuration, never request input.
IMAGE_WATERMARK_ASSET_PATH=""
IMAGE_WATERMARK_SIZE_PERCENT=18
IMAGE_WATERMARK_OPACITY_PERCENT=35
IMAGE_WATERMARK_MARGIN_PERCENT=2
IMAGE_WATERMARK_GRAVITY="southeast"
IMAGE_WATERMARK_THUMBNAIL=false
IMAGE_WATERMARK_PREVIEW=false
IMAGE_WATERMARK_LARGE=false

# Superseded derivative versions remain origin-addressable for a conservative
# grace period longer than the current one-year immutable cache age. Historical
# derivative URLs are not permanent. The newest two generations are always kept.
DERIVATIVE_RETENTION_GRACE_DAYS=400
DERIVATIVE_RETENTION_KEEP_GENERATIONS=2

# Optional read-only source used only by the Coppermine migration commands.
# Prefer a database account with SELECT privileges only.
COPPERMINE_DATABASE_URL=""
COPPERMINE_TABLE_PREFIX="cpg_"
COPPERMINE_ALBUMS_ROOT=""
