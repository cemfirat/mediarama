{% extends 'base.html.twig' %}

{% block title %}Library · Mediarama{% endblock %}

{% block body %}
<div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap">
    <div>
        <h1 class="uk-heading-small uk-margin-remove-bottom">Library</h1>
        <p class="uk-text-lead uk-margin-small-top">Search your accessible media and save useful filters as Smart Collections.</p>
    </div>
    <div>
        <a class="uk-button uk-button-default" href="{{ path('library_organization') }}">Organization</a>
        <a class="uk-button uk-button-default uk-margin-small-left" href="{{ path('library_smart_collections') }}">Smart Collections</a>
    </div>
</div>

{% if error %}
    <div class="uk-alert-danger" uk-alert><p>{{ error }}</p></div>
{% endif %}
{% if smart_error == 'unsupported_filter' %}
    <div class="uk-alert-warning" uk-alert>
        <p>This filter cannot be saved losslessly as a Smart Collection V1 rule. Remove free-text, ISO or exact-location-presence filters first.</p>
    </div>
{% elseif smart_error == 'converted_manual' %}
    <div class="uk-alert-success" uk-alert><p>The Smart Collection was converted back to Manual mode.</p></div>
{% endif %}
{% if organization_error == 'invalid_scope' %}
    <div class="uk-alert-warning" uk-alert>
        <p>Select one or more currently accessible MediaAssets before starting an organization analysis.</p>
    </div>
{% elseif organization_error == 'ai_preflight' %}
    <div class="uk-alert-warning" uk-alert>
        <p>The AI analysis request could not be prepared safely. Check the selected provider, capabilities, input mode and media scope.</p>
    </div>
{% endif %}

<section class="uk-card uk-card-default uk-card-body uk-margin-large-top" aria-labelledby="library-filter-heading">
    <h2 id="library-filter-heading" class="uk-card-title">Filter media</h2>
    <form method="get" class="uk-form-stacked">
        <div class="uk-grid-small uk-child-width-1-2@m uk-child-width-1-3@l" uk-grid>
            <div><label class="uk-form-label">Text<input class="uk-input" type="search" name="q" value="{{ filters.q }}"></label></div>
            <div><label class="uk-form-label">Creator<input class="uk-input" name="creator" value="{{ filters.creator }}"></label></div>
            <div><label class="uk-form-label">Camera make<input class="uk-input" name="camera_make" value="{{ filters.camera_make }}"></label></div>
            <div><label class="uk-form-label">Camera model<input class="uk-input" name="camera_model" value="{{ filters.camera_model }}"></label></div>
            <div><label class="uk-form-label">Lens<input class="uk-input" name="lens" value="{{ filters.lens }}"></label></div>
            <div>
                <label class="uk-form-label">Media type</label>
                <select class="uk-select" name="media_type">
                    <option value="" {% if filters.media_type == '' %}selected{% endif %}>Any</option>
                    <option value="image" {% if filters.media_type == 'image' %}selected{% endif %}>Image</option>
                    <option value="video" {% if filters.media_type == 'video' %}selected{% endif %}>Video</option>
                    <option value="audio" {% if filters.media_type == 'audio' %}selected{% endif %}>Audio</option>
                    <option value="document" {% if filters.media_type == 'document' %}selected{% endif %}>Document</option>
                </select>
            </div>
            <div><label class="uk-form-label">Location name<input class="uk-input" name="location_name" value="{{ filters.location_name }}" placeholder="Coarse place name"></label></div>
            <div><label class="uk-form-label">Tag<input class="uk-input" name="tag" value="{{ filters.tag }}" placeholder="Tag name or slug"></label></div>
            <div><label class="uk-form-label">Minimum average rating<input class="uk-input" type="number" min="1" max="5" step="0.1" name="rating_min" value="{{ filters.rating_min }}"></label></div>
            <div>
                <label class="uk-form-label">Orientation</label>
                <select class="uk-select" name="orientation">
                    <option value="" {% if filters.orientation == '' %}selected{% endif %}>Any</option>
                    <option value="portrait" {% if filters.orientation == 'portrait' %}selected{% endif %}>Portrait</option>
                    <option value="landscape" {% if filters.orientation == 'landscape' %}selected{% endif %}>Landscape</option>
                    <option value="square" {% if filters.orientation == 'square' %}selected{% endif %}>Square</option>
                </select>
            </div>
            <div><label class="uk-form-label">ISO minimum<input class="uk-input" type="number" min="1" name="iso_min" value="{{ filters.iso_min }}"></label></div>
            <div><label class="uk-form-label">ISO maximum<input class="uk-input" type="number" min="1" name="iso_max" value="{{ filters.iso_max }}"></label></div>
            <div><label class="uk-form-label">Captured from<input class="uk-input" type="date" name="captured_from" value="{{ filters.captured_from }}"></label></div>
            <div><label class="uk-form-label">Captured until<input class="uk-input" type="date" name="captured_until" value="{{ filters.captured_until }}"></label></div>
            <div>
                <label class="uk-form-label">GPS coordinates present <span class="uk-text-muted">(search only)</span></label>
                <select class="uk-select" name="has_location">
                    <option value="" {% if filters.has_location == '' %}selected{% endif %}>Any</option>
                    <option value="1" {% if filters.has_location == '1' %}selected{% endif %}>Present</option>
                    <option value="0" {% if filters.has_location == '0' %}selected{% endif %}>Missing</option>
                </select>
            </div>
        </div>
        <div class="uk-margin">
            <button class="uk-button uk-button-primary" type="submit">Apply filter</button>
            <a class="uk-button uk-button-text uk-margin-left" href="{{ path('library_home') }}">Reset</a>
        </div>
    </form>
</section>

{% if filter_has_compatible_rule %}
<section class="uk-card uk-card-default uk-card-body uk-margin" aria-labelledby="save-filter-heading">
    <h2 id="save-filter-heading" class="uk-card-title">Save as Smart Collection</h2>
    {% if filter_save_supported %}
        <form method="post" action="{{ path('library_smart_collection_from_filter') }}" class="uk-form-stacked">
            <input type="hidden" name="_csrf_token" value="{{ filter_csrf_token }}">
            {% for key, value in filters %}
                {% if value != '' %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endif %}
            {% endfor %}
            <div class="uk-grid-small uk-flex-middle" uk-grid>
                <div class="uk-width-expand"><input class="uk-input" name="title" maxlength="200" required placeholder="Smart Collection title"></div>
                <div class="uk-width-auto"><button class="uk-button uk-button-secondary" type="submit">Save filter</button></div>
            </div>
            <p class="uk-text-meta uk-margin-small-top">The saved rule stays private and dynamic. It does not copy matching media into manual Collection membership.</p>
        </form>
    {% else %}
        <div class="uk-alert-warning" uk-alert>
            <p>This view contains filters that Smart Collection rule V1 cannot represent safely. Free-text, ISO and exact coordinate-presence filters are intentionally not serialized.</p>
        </div>
    {% endif %}
</section>
{% endif %}

<section class="uk-margin-large-top" aria-labelledby="library-results-heading">
    <h2 id="library-results-heading" class="uk-h3">Results</h2>
    {% if items is empty %}
        <div class="uk-placeholder uk-text-center">No matching media.</div>
    {% else %}
        <form id="organization-scope-form" method="post" action="{{ path('library_organization_analyze') }}">
            <div class="uk-card uk-card-default uk-card-body uk-margin">
                <div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap">
                    <div>
                        <strong>Organization analysis</strong>
                        <div class="uk-text-meta">Select MediaAssets below. Deterministic analysis always stays available without an AI provider.</div>
                    </div>
                    <button class="uk-button uk-button-secondary"
                            type="submit"
                            formaction="{{ path('library_organization_analyze') }}"
                            name="_csrf_token"
                            value="{{ organization_csrf_token }}">Analyze selected</button>
                </div>

                {% if organization_ai_providers is not empty %}
                <details class="uk-margin-top">
                    <summary class="uk-button uk-button-text">AI-assisted analysis</summary>
                    <div class="uk-margin uk-card uk-card-muted uk-card-body">
                        <p>
                            Provider execution is blocked until you review and explicitly approve a persisted privacy/cost preflight.
                            Immutable originals, exact GPS, raw metadata, provenance and source storage are never part of the provider request.
                        </p>

                        <fieldset class="uk-fieldset">
                            <legend class="uk-legend uk-h4">Provider and capabilities</legend>
                            <div class="uk-child-width-1-2@m uk-grid-match" uk-grid>
                                {% for provider in organization_ai_providers %}
                                {% set provider_slot = loop.index0 %}
                                <div>
                                    <div class="uk-card uk-card-default uk-card-body">
                                        <input type="hidden"
                                               name="provider_keys[{{ provider_slot }}]"
                                               value="{{ provider.key }}">
                                        <label class="uk-display-block">
                                            <input class="uk-radio"
                                                   type="radio"
                                                   name="provider_slot"
                                                   value="{{ provider_slot }}"
                                                   {% if loop.first %}checked{% endif %}>
                                            <strong>{{ provider.providerName }}</strong>
                                        </label>
                                        <div class="uk-text-meta">
                                            {{ provider.producerKind.value|replace({'_':' '}) }} · {{ provider.modelName }}
                                            {% if provider.modelVersion %} · {{ provider.modelVersion }}{% endif %}
                                        </div>
                                        <div class="uk-margin-small-top">
                                            {% for capability in provider.capabilities %}
                                                {% if capability.value != 'local_inference' %}
                                                <label class="uk-display-block uk-margin-small-top">
                                                    <input class="uk-checkbox"
                                                           type="checkbox"
                                                           name="capabilities[{{ provider_slot }}][]"
                                                           value="{{ capability.value }}"
                                                           {% if capability.value == 'text_reasoning' %}checked{% endif %}>
                                                    {{ capability.value|replace({'_':' '}) }}
                                                </label>
                                                {% else %}
                                                    <span class="uk-label uk-margin-small-top">local inference</span>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </fieldset>

                        <div class="uk-grid-small uk-child-width-1-2@m uk-margin" uk-grid>
                            <div>
                                <label class="uk-form-label">Input mode</label>
                                <select class="uk-select" name="input_mode">
                                    <option value="metadata_only" selected>Metadata only</option>
                                    <option value="metadata_and_presentation">Metadata + bounded presentation derivatives</option>
                                </select>
                                <div class="uk-text-meta uk-margin-small-top">Image understanding requires presentation mode and an available generated preview/poster.</div>
                            </div>
                            <div>
                                <label class="uk-form-label">Optional metadata</label>
                                <label class="uk-display-block"><input class="uk-checkbox" type="checkbox" name="include_creator" value="1"> Include creator</label>
                                <label class="uk-display-block uk-margin-small-top"><input class="uk-checkbox" type="checkbox" name="include_location_name" value="1"> Include coarse location name</label>
                                <div class="uk-text-meta uk-margin-small-top">Exact GPS stays excluded regardless of these choices.</div>
                            </div>
                        </div>

                        <button class="uk-button uk-button-primary"
                                type="submit"
                                formaction="{{ path('library_organization_ai_prepare') }}"
                                name="_csrf_token"
                                value="{{ organization_ai_prepare_csrf_token }}">Review AI preflight</button>
                    </div>
                </details>
                {% endif %}
            </div>

            <div class="uk-overflow-auto">
                <table class="uk-table uk-table-divider uk-table-small uk-table-middle">
                    <thead><tr><th>Analyze</th><th>Title</th><th>File</th><th>Captured</th><th>Creator</th><th>Camera</th><th>Location</th></tr></thead>
                    <tbody>
                    {% for item in items %}
                        <tr>
                            <td>
                                <input class="uk-checkbox"
                                       type="checkbox"
                                       name="media_ids[]"
                                       value="{{ item.id.toRfc4122() }}"
                                       aria-label="Select {{ item.title ?: 'untitled MediaAsset' }} for organization analysis">
                            </td>
                            <td>{{ item.title ?: 'Untitled' }}</td>
                            <td class="uk-text-meta">{{ item.originalFilename }}</td>
                            <td>{{ item.capturedAt ? item.capturedAt|date('Y-m-d H:i') : '—' }}</td>
                            <td>{{ item.creator ?: '—' }}</td>
                            <td>{{ item.cameraModel ?: item.cameraMake ?: '—' }}</td>
                            <td>{{ item.locationName ?: '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </form>
    {% endif %}
</section>
{% endblock %}
