{% extends 'base.html.twig' %}

{% block title %}Metadata · {{ workspace.title ?: workspace.originalFilename }} · Mediarama{% endblock %}

{% block body %}
<div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap">
    <div>
        <a class="uk-text-meta" href="{{ path('library_home') }}">← Back to Library</a>
        <h1 class="uk-heading-small uk-margin-small-top uk-margin-remove-bottom">Metadata workspace</h1>
        <p class="uk-text-lead uk-margin-small-top">{{ workspace.title ?: workspace.originalFilename }}</p>
    </div>
    <span class="uk-label">Canonical editing · source read-only</span>
</div>

<div class="uk-alert-warning" uk-alert>
    <p><strong>Owner-only source inspection.</strong> Embedded metadata can contain exact GPS, creator identity, device serials and other private values. This page is private, non-indexable and never rewrites the immutable original or source snapshot.</p>
</div>

{% if saved %}
    <div class="uk-alert-success" uk-alert><p>Canonical metadata changes were saved. Source metadata remains unchanged.</p></div>
{% elseif edit_error %}
    <div class="uk-alert-danger" uk-alert><p>The metadata change was not applied. Choose Set, Clear or an available Revert deliberately. Blank Set values and ambiguous/missing source values are rejected.</p></div>
{% endif %}

{% if keywords_saved %}
    <div class="uk-alert-success" uk-alert><p>Keyword changes were saved. The immutable source keyword snapshot remains unchanged.</p></div>
{% elseif keywords_error %}
    <div class="uk-alert-danger" uk-alert><p>The keyword change was not applied. Supply one valid keyword per line, choose an operation deliberately and use Clear rather than a blank replacement.</p></div>
{% endif %}

<section class="uk-card uk-card-default uk-card-body uk-margin" aria-labelledby="metadata-edit-heading">
    <h2 id="metadata-edit-heading" class="uk-card-title">Edit descriptive metadata</h2>
    <p class="uk-text-meta">Each field defaults to <strong>Keep</strong>. Choose <strong>Set</strong> to replace the current canonical value, <strong>Clear</strong> to deliberately remove it, or <strong>Revert</strong> to restore the explicitly mapped source value shown below. Blank Set values are rejected.</p>
    <form method="post" action="{{ path('library_media_metadata_workspace_update', {id: workspace.id.toRfc4122()}) }}" class="uk-form-stacked">
        <input type="hidden" name="_csrf_token" value="{{ edit_csrf_token }}">
        {% for field in workspace.currentFields %}
            {% if field.key in ['title', 'description', 'creator', 'copyright', 'location_name'] %}
                <div class="uk-grid-small uk-margin-small" uk-grid>
                    <div class="uk-width-1-4@m">
                        <label class="uk-form-label" for="metadata-action-{{ field.key }}">{{ field.label }}</label>
                        <select id="metadata-action-{{ field.key }}" class="uk-select" name="actions[{{ field.key }}]">
                            <option value="keep" selected>Keep</option>
                            <option value="set">Set</option>
                            <option value="clear">Clear</option>
                            {% if field.canRevert %}<option value="revert">Revert to source</option>{% endif %}
                        </select>
                        {% if field.sensitive %}<div class="uk-text-meta uk-text-warning">Privacy-sensitive</div>{% endif %}
                    </div>
                    <div class="uk-width-expand@m">
                        <label class="uk-form-label" for="metadata-value-{{ field.key }}">Value</label>
                        {% if field.key == 'description' %}
                            <textarea id="metadata-value-{{ field.key }}" class="uk-textarea" rows="4" maxlength="5000" name="values[{{ field.key }}]">{{ field.value ?: '' }}</textarea>
                        {% else %}
                            <input id="metadata-value-{{ field.key }}"
                                   class="uk-input"
                                   type="text"
                                   {% if field.key == 'title' %}maxlength="200"{% elseif field.key == 'creator' %}maxlength="500"{% else %}maxlength="1000"{% endif %}
                                   name="values[{{ field.key }}]"
                                   value="{{ field.value ?: '' }}">
                        {% endif %}
                        <div class="uk-text-meta">Current provenance: {{ field.provenance ?: '—' }}</div>
                        {% if field.canRevert %}
                            <div class="uk-alert-primary uk-padding-small uk-margin-small-top">
                                <strong>Source candidate:</strong>
                                <span class="uk-text-break">{{ field.sourceValue }}</span>
                                <div class="uk-text-meta">Mapped from <code>{{ field.sourceTag }}</code>. Revert restores this value with provenance <code>embedded</code>.</div>
                            </div>
                        {% else %}
                            <div class="uk-text-meta uk-margin-small-top">No unambiguous mapped source value is available; Revert is disabled.</div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        <button class="uk-button uk-button-primary" type="submit">Save selected changes</button>
    </form>
</section>

<section class="uk-card uk-card-default uk-card-body uk-margin" aria-labelledby="metadata-keywords-heading">
    <h2 id="metadata-keywords-heading" class="uk-card-title">Edit keywords</h2>
    <p class="uk-text-meta">Keywords use Mediarama's relational tag model. Choose <strong>Replace</strong>, <strong>Append</strong>, <strong>Remove</strong>, <strong>Clear all</strong> or an available <strong>Revert to source</strong>. Blank input never means deletion.</p>

    <h3 class="uk-heading-bullet uk-margin-small-bottom">Current keywords</h3>
    {% if workspace.keywords.current is empty %}
        <p class="uk-text-muted">No current keywords.</p>
    {% else %}
        <div class="uk-flex uk-flex-wrap uk-grid-small" uk-grid>
            {% for keyword in workspace.keywords.current %}
                <div><span class="uk-label">{{ keyword.name }}</span> <span class="uk-text-meta">{{ keyword.source }}</span></div>
            {% endfor %}
        </div>
    {% endif %}

    {% if workspace.keywords.canRevert %}
        <div class="uk-alert-primary uk-padding-small uk-margin">
            <strong>Source keyword candidate:</strong>
            <div class="uk-margin-small-top">
                {% for keyword in workspace.keywords.sourceValues %}
                    <span class="uk-label uk-margin-small-right">{{ keyword }}</span>
                {% endfor %}
            </div>
            <div class="uk-text-meta uk-margin-small-top">Mapped from <code>{{ workspace.keywords.sourceTag }}</code>. Revert replaces the current keyword set and records each membership as <code>embedded</code>.</div>
        </div>
    {% else %}
        <p class="uk-text-meta">No unambiguous mapped source keyword list is available; Revert is disabled.</p>
    {% endif %}

    <form method="post" action="{{ path('library_media_metadata_workspace_keywords', {id: workspace.id.toRfc4122()}) }}" class="uk-form-stacked uk-margin-top">
        <input type="hidden" name="_csrf_token" value="{{ keyword_csrf_token }}">
        <div class="uk-grid-small" uk-grid>
            <div class="uk-width-1-4@m">
                <label class="uk-form-label" for="metadata-keyword-action">Operation</label>
                <select id="metadata-keyword-action" class="uk-select" name="keyword_action">
                    <option value="append" selected>Append</option>
                    <option value="replace">Replace</option>
                    <option value="remove">Remove</option>
                    <option value="clear">Clear all</option>
                    {% if workspace.keywords.canRevert %}<option value="revert">Revert to source</option>{% endif %}
                </select>
            </div>
            <div class="uk-width-expand@m">
                <label class="uk-form-label" for="metadata-keyword-values">Keywords</label>
                <textarea id="metadata-keyword-values"
                          class="uk-textarea"
                          rows="6"
                          maxlength="32200"
                          name="keyword_values"
                          placeholder="One keyword per line"></textarea>
                <div class="uk-text-meta">Up to 200 keywords, each 1–160 printable characters. Values are matched case-insensitively and de-duplicated.</div>
            </div>
        </div>
        <button class="uk-button uk-button-primary uk-margin-small-top" type="submit">Apply keyword operation</button>
    </form>
</section>

<section class="uk-card uk-card-default uk-card-body uk-margin" aria-labelledby="metadata-summary-heading">
    <h2 id="metadata-summary-heading" class="uk-card-title">File summary</h2>
    <dl class="uk-description-list uk-description-list-divider">
        <dt>Original filename</dt><dd>{{ workspace.originalFilename }}</dd>
        <dt>Media type</dt><dd>{{ workspace.mediaType }} · {{ workspace.mimeType }}</dd>
        <dt>Size</dt><dd>{{ workspace.byteSize|number_format(0, '.', ',') }} bytes</dd>
        <dt>Dimensions</dt><dd>{{ workspace.width and workspace.height ? workspace.width ~ ' × ' ~ workspace.height : '—' }}</dd>
        {% if workspace.durationMs is not null %}<dt>Duration</dt><dd>{{ workspace.durationMs }} ms</dd>{% endif %}
        <dt>Workspace last changed</dt><dd>{{ workspace.updatedAt|date('Y-m-d H:i:s T') }}</dd>
    </dl>
</section>

<section class="uk-card uk-card-default uk-card-body uk-margin" aria-labelledby="current-metadata-heading">
    <h2 id="current-metadata-heading" class="uk-card-title">Current Mediarama values</h2>
    <p class="uk-text-meta">These are the current canonical/project values. Provenance records where each current value came from; it does not rewrite source metadata.</p>
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-divider uk-table-small uk-table-middle">
            <thead><tr><th>Field</th><th>Current Mediarama value</th><th>Provenance</th><th>Privacy</th></tr></thead>
            <tbody>
            {% for field in workspace.currentFields %}
                <tr>
                    <td><strong>{{ field.label }}</strong><div class="uk-text-meta">{{ field.key }}</div></td>
                    <td class="uk-text-break">{{ field.value is not null ? field.value : '—' }}</td>
                    <td>{{ field.provenance ?: '—' }}</td>
                    <td>{% if field.sensitive %}<span class="uk-label uk-label-warning">Privacy-sensitive</span>{% else %}—{% endif %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>

<section class="uk-card uk-card-default uk-card-body uk-margin" aria-labelledby="source-metadata-heading">
    <h2 id="source-metadata-heading" class="uk-card-title">Source snapshot</h2>
    <p class="uk-text-meta">Read-only metadata captured from the immutable original. Unknown tags remain inspectable instead of being discarded.</p>

    {% for key, group in workspace.sourceGroups %}
        <details class="uk-card uk-card-small uk-card-muted uk-card-body uk-margin-small" {% if key in ['exif', 'iptc', 'xmp'] %}open{% endif %}>
            <summary class="uk-text-bold">{{ group.label }} <span class="uk-text-meta">({{ group.tags|length }} tags)</span></summary>
            {% if group.tags is empty %}
                <p class="uk-text-muted uk-margin-small-top">No source tags in this section.</p>
            {% else %}
                <div class="uk-overflow-auto uk-margin-small-top">
                    <table class="uk-table uk-table-divider uk-table-small uk-table-middle">
                        <thead><tr><th>Source tag</th><th>Source value</th><th>Privacy</th></tr></thead>
                        <tbody>
                        {% for tag in group.tags %}
                            <tr>
                                <td><code>{{ tag.name }}</code></td>
                                <td><pre class="uk-margin-remove uk-text-small uk-text-break">{{ tag.value }}</pre></td>
                                <td>{% if tag.sensitive %}<span class="uk-label uk-label-warning">Privacy-sensitive</span>{% else %}—{% endif %}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </details>
    {% endfor %}
</section>
{% endblock %}
