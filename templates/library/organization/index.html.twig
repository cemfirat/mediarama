{% extends 'base.html.twig' %}

{% block title %}Organization · Mediarama{% endblock %}

{% block body %}
<div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap">
    <div>
        <h1 class="uk-heading-small uk-margin-remove-bottom">Organization</h1>
        <p class="uk-text-lead uk-margin-small-top">Review organization analyses before anything changes in your library.</p>
    </div>
    <a class="uk-button uk-button-primary" href="{{ path('library_home') }}">Select media in Library</a>
</div>

<div class="uk-alert-primary uk-margin" uk-alert>
    <p>Analysis creates private review proposals only. Nothing is published, moved, tagged or reorganized until you accept a proposal.</p>
</div>

{% if runs is empty %}
    <div class="uk-placeholder uk-text-center">
        No organization analyses yet. Select media in Library and choose Analyze selected.
    </div>
{% else %}
    <div class="uk-child-width-1-2@m uk-grid-match uk-margin-large-top" uk-grid>
        {% for run in runs %}
            <div>
                <a class="uk-card uk-card-default uk-card-hover uk-card-body uk-display-block uk-link-reset"
                   href="{{ path('library_organization_run', {id: run.id.toRfc4122()}) }}">
                    <div class="uk-flex uk-flex-between uk-flex-middle">
                        <h2 class="uk-card-title uk-margin-remove">Analysis</h2>
                        <span class="uk-label">{{ run.status.value|replace({'_':' '}) }}</span>
                    </div>
                    <p class="uk-margin-small">
                        {{ run.mediaCount }} MediaAssets · {{ run.producer.kind.value|replace({'_':' '}) }}
                    </p>
                    {% if run.producer.providerName %}
                        <p class="uk-text-meta uk-margin-small">
                            {{ run.producer.providerName }} · {{ run.producer.modelName }}{% if run.producer.modelVersion %} · {{ run.producer.modelVersion }}{% endif %}
                        </p>
                    {% endif %}
                    <p class="uk-text-meta uk-margin-remove">Updated {{ run.updatedAt|date('Y-m-d H:i') }}</p>
                </a>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
