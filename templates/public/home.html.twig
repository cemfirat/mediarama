{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
<section class="uk-section uk-section-small">
    <div class="uk-width-2xlarge">
        <p class="uk-text-meta uk-margin-remove-bottom">Photo & video gallery</p>
        <h1 class="uk-heading-medium uk-margin-small-top">Mediarama</h1>
        <p class="uk-text-lead">
            A modern, self-hostable media gallery with clean architecture, flexible collections and first-class image and video support.
        </p>
        <p>
            <a class="uk-button uk-button-primary" href="{{ path('public_collections') }}">Browse collections</a>
        </p>
    </div>
</section>

<section class="uk-section uk-section-small">
    <div class="uk-grid-small uk-child-width-1-2@s uk-child-width-1-3@l" uk-grid>
        <div>
            <article class="uk-card uk-card-default uk-card-body">
                <h2 class="uk-card-title">Collections</h2>
                <p>Organize one media asset in multiple collections without duplicating the original.</p>
            </article>
        </div>
        <div>
            <article class="uk-card uk-card-default uk-card-body">
                <h2 class="uk-card-title">Media</h2>
                <p>Immutable originals with regeneratable thumbnails, previews and future video renditions.</p>
            </article>
        </div>
        <div>
            <article class="uk-card uk-card-default uk-card-body">
                <h2 class="uk-card-title">Migration</h2>
                <p>Designed to import existing Coppermine galleries into a normalized modern model.</p>
            </article>
        </div>
    </div>
</section>
{% endblock %}
