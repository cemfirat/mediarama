  "visual_review": {
    "scope": "Six manifest-verified high-resolution PD-own sources, retained lossless references and WebP/JPEG/AVIF Q55/Q70/Q82/Q90 candidates; thumbnail, preview, large and detail crops reviewed.",
    "result": "No systematic visual defect or decisive perceptual advantage contradicted the measured curves. At comparable measured quality, AVIF mainly reduced bytes while JPEG mainly reduced encode time."
  },
  "decision_support": {
    "webp": "Retain cwebp WebP as the sole standard display derivative codec in the current single-format profile architecture.",
    "jpeg": "Do not expose JPEG display profiles: materially larger at comparable PSNR and alpha semantics would need a new explicit policy, despite faster encoding.",
    "avif": "Do not replace WebP with AVIF in the current single-format model. Revisit only with an intentional multi-format variant/fallback model and refreshed production-backend benchmarks."
  }
